{
  "name": "@asaidimu/anansi",
  "version": "8.7.2",
  "description": "Self-contained TypeScript implementation of the Anansi binary wire format — schema compile/link/addressing, dense/sparse/batch packet codecs, transforms (zstd/BLAKE3/AES-GCM), and document validation. Byte-compatible with the Go implementation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "ci": "bun install --frozen-lockfile",
    "build": "tsdown",
    "test": "bun test",
    "clean": "[ -e ./dist ] && rm -rf ./dist || echo No dist",
    "prebuild": "bun clean",
    "postbuild": "cp README.md ./dist && bun run .sync-package.ts && mv out.package.json ./dist/package.json",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "anansi",
    "binary",
    "wire-format",
    "serialization",
    "schema",
    "codec",
    "validation",
    "typescript"
  ],
  "author": "Saidimu <47994458+asaidimu@users.noreply.github.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asaidimu/go-anansi.git",
    "directory": "packages/anansi"
  },
  "bugs": {
    "url": "https://github.com/asaidimu/go-anansi/issues"
  },
  "homepage": "https://github.com/asaidimu/go-anansi/tree/main/packages/anansi#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "access": "public"
  },
  "dependencies": {
    "@asaidimu/query": "^1.1.2",
    "@standard-schema/spec": "^1.1.0",
    "fzstd": "^0.1.1",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/bun": "latest",
    "tsdown": "^0.22.9",
    "typescript": "^5.6.0"
  }
}
