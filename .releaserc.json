{
  "branches": [ "main" ],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/prepare-release.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "packages/anansi/dist"
      }
    ],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": [
          "packages/anansi/package.json",
          "packages/anansi/dist.package.json",
          "CHANGELOG.md"
        ],
        "message": "release(release): v${nextRelease.version} [skip ci]"
      }
    ]
  ]
}
